    "contador = 0\n",
    "numero = int(input())\n",
    "\n",
    "while numero != 0:\n",
    "    if numero > 0:\n",
    "        contador += 1\n",
    "    \n",
    "    numero = int(input())\n",
    "\n",
    "print(f\"Has ingresado un total de {contador} numeros naturales\")"
   ]
